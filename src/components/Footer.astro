---
import { Image } from 'astro:assets';
import logoFeerie from '../assets/logo-feerie-white.png';
import logoBrickell from '../assets/logo-brickell-white.png';
import { performances } from '../data/performances';

const explore = [
  { href: '#performances', label: 'Performances' },
  { href: '#services', label: 'Services' },
  { href: '#mission', label: 'Our Mission' },
  { href: '#work', label: 'Our Work' },
  { href: '#alliance', label: 'Global Presence' },
  { href: '#contact', label: 'Contact' },
];

---

<footer id="site-footer" class="relative overflow-hidden border-t border-line bg-ink">
  <div class="grid gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[1.6fr_1fr_1fr_1.2fr] lg:gap-10 lg:px-12 lg:py-20">
    <div class="flex flex-col gap-6">
      <a href="#" aria-label="Féerie, back to top" class="w-fit">
        <Image src={logoFeerie} alt="Féerie" class="h-10 w-auto" densities={[1, 2]} />
      </a>
      <p class="max-w-[38ch] text-sm leading-relaxed text-dim">
        Luxury entertainment production in Miami. Live shows, professional dancers and custom
        costumes for events that refuse to be ordinary.
      </p>
      <p class="text-xs tracking-[0.18em] text-dim uppercase">
        Miami &middot; <span id="miami-time">--:--</span> local time
      </p>
    </div>

    <nav class="flex flex-col gap-3" aria-label="Site sections">
      <p class="mb-1 text-[0.68rem] font-medium tracking-[0.24em] text-dim uppercase">Explore</p>
      {
        explore.map((l) => (
          <a href={l.href} class="w-fit text-sm text-bone/85 transition-colors duration-300 hover:text-rose">
            {l.label}
          </a>
        ))
      }
    </nav>

    <nav class="flex flex-col gap-3" aria-label="Shows">
      <p class="mb-1 text-[0.68rem] font-medium tracking-[0.24em] text-dim uppercase">The Shows</p>
      {
        performances.map((p) => (
          <a
            href={`/performances/${p.slug}/`}
            class="w-fit text-sm text-bone/85 transition-colors duration-300 hover:text-rose"
          >
            {p.name}
          </a>
        ))
      }
    </nav>

    <div class="flex flex-col gap-3" aria-label="Contact details">
      <p class="mb-1 text-[0.68rem] font-medium tracking-[0.24em] text-dim uppercase">
        Get in Touch
      </p>
      <a
        href="mailto:feerieshows@feerie.com"
        class="w-fit text-sm text-bone/85 transition-colors duration-300 hover:text-rose"
      >
        feerieshows@feerie.com
      </a>
      <a
        href="tel:+17862529292"
        class="w-fit text-sm text-bone/85 transition-colors duration-300 hover:text-rose"
      >
        (786) 252 9292
      </a>
      <div class="mt-3 flex flex-col gap-3 text-sm">
        <a
          href="https://www.instagram.com/feerieshows"
          target="_blank"
          rel="noopener"
          class="flex w-fit items-center gap-2.5 text-bone/85 transition-colors duration-300 hover:text-rose"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5.5" stroke="currentColor" stroke-width="1.8" />
            <circle cx="12" cy="12" r="4.6" stroke="currentColor" stroke-width="1.8" />
            <circle cx="17.6" cy="6.4" r="1.3" fill="currentColor" />
          </svg>
          @feerieshows
        </a>
        <a
          href="https://www.instagram.com/wepaproducciones"
          target="_blank"
          rel="noopener"
          class="flex w-fit items-center gap-2.5 text-bone/85 transition-colors duration-300 hover:text-rose"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5.5" stroke="currentColor" stroke-width="1.8" />
            <circle cx="12" cy="12" r="4.6" stroke="currentColor" stroke-width="1.8" />
            <circle cx="17.6" cy="6.4" r="1.3" fill="currentColor" />
          </svg>
          @wepaproducciones
        </a>
      </div>
    </div>
  </div>

  <div class="relative border-t border-line px-5 py-8 sm:px-8 lg:px-12">
    <div
      class="flex flex-col items-center gap-5 text-center lg:flex-row lg:items-center lg:justify-between lg:text-left"
    >
      <p class="text-xs text-dim">&copy; 2025 F&Eacute;ERIE. All rights reserved.</p>
      <div class="flex items-center gap-4 text-xs">
        <a href="#" class="text-dim transition-colors duration-300 hover:text-rose">
          Privacy Policy
        </a>
        <span class="h-3 w-px bg-line-strong" aria-hidden="true"></span>
        <a href="#" class="text-dim transition-colors duration-300 hover:text-rose">
          Terms &amp; Conditions
        </a>
      </div>
      <span data-touch class="group flex items-center gap-2.5 text-xs text-dim">
        Crafted by
        <Image
          src={logoBrickell}
          alt="Brickell Lab"
          class="h-4 w-auto opacity-60 transition-opacity duration-300 group-hover:opacity-100"
          densities={[1, 2]}
        />
      </span>
    </div>
  </div>

</footer>

<script>
  // Hora local de Miami en vivo
  const timeEl = document.getElementById('miami-time');
  if (timeEl) {
    const fmt = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/New_York',
      hour: 'numeric',
      minute: '2-digit',
    });
    const tick = () => (timeEl.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 10000);
  }
</script>
