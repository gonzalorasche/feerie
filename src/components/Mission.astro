<section id="mission" class="relative overflow-hidden bg-ink py-20 lg:py-28">
  <div
    class="absolute inset-0"
    style="background:radial-gradient(50% 60% at 70% 20%,rgba(232,72,110,.09),transparent 70%),radial-gradient(40% 50% at 15% 85%,rgba(232,72,110,.05),transparent 70%)"
    aria-hidden="true"
  >
  </div>
  <div class="grain absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto flex max-w-[60rem] flex-col items-center gap-7 px-5 text-center sm:px-8">
    <p class="eyebrow">Our Mission</p>
    <h2 class="text-[clamp(2.2rem,5.6vw,4.2rem)] leading-[1.02] text-bone">
      Elevating Miami&rsquo;s <em class="not-italic text-rose-soft">nightlife</em>
    </h2>
    <p class="max-w-[62ch] text-base leading-relaxed text-dim lg:text-lg">
      With deep roots in Miami&rsquo;s nightlife and event scene, Féerie produces immersive
      entertainment that brings energy, beauty and creativity to every kind of celebration, from
      intimate weddings to large scale brand activations.
    </p>
    <p class="max-w-[54ch] text-base leading-relaxed text-bone/85 lg:text-lg">
      Unique costumes, top tier dancers and unforgettable performances that take your event to the
      next level.
    </p>
    <div class="mt-3 flex flex-wrap justify-center gap-3">
      <a href="#contact" class="btn btn-fill">Let&rsquo;s Work Together</a>
      <a href="#work" class="btn btn-ghost">See Our Work</a>
    </div>
  </div>
</section>
