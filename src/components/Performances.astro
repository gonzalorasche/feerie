---
import { Image } from 'astro:assets';
import { performances, imagesFor } from '../data/performances';

const items = performances.map((p) => ({ ...p, cover: imagesFor(p.slug)[0] }));
const BASE = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<section id="performances" class="pf relative overflow-hidden bg-ink py-20 lg:py-28">
  <header class="mb-10 flex flex-col gap-4 px-5 sm:px-8 lg:mb-12 lg:px-12">
    <p class="eyebrow">The Acts</p>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="max-w-[22ch] text-[clamp(1.9rem,4.6vw,3.4rem)] leading-[1.02] text-bone">
        Shows that turn a venue into a <em class="not-italic text-rose-soft">stage</em>
      </h2>
      <div class="flex items-center gap-3">
        <button
          type="button"
          class="pf-prev flex size-12 cursor-pointer items-center justify-center rounded-full border border-line-strong text-bone transition-all duration-300 hover:border-rose hover:bg-rose hover:text-[#120507] disabled:pointer-events-none disabled:opacity-30"
          aria-label="Previous shows"
        >
          &larr;
        </button>
        <button
          type="button"
          class="pf-next flex size-12 cursor-pointer items-center justify-center rounded-full border border-line-strong text-bone transition-all duration-300 hover:border-rose hover:bg-rose hover:text-[#120507] disabled:pointer-events-none disabled:opacity-30"
          aria-label="Next shows"
        >
          &rarr;
        </button>
      </div>
    </div>
  </header>

  <div class="pf-viewport cursor-grab overflow-hidden active:cursor-grabbing" aria-label="Féerie performances carousel">
    <div class="pf-track flex touch-pan-y gap-5 pr-5 pl-5 sm:pr-8 sm:pl-8 lg:gap-6 lg:pr-12 lg:pl-12">
      {
        items.map((p) => (
          <a
            href={`${BASE}performances/${p.slug}/`}
            draggable="false"
            data-touch
            class={`pf-card group relative block h-[64svh] w-[80vw] shrink-0 overflow-hidden rounded-3xl border border-bone/10 bg-card select-none sm:w-[22rem] lg:h-[62vh] ${
              p.featured ? 'lg:w-[30rem]' : 'lg:w-[24rem]'
            }`}
          >
            <Image
              src={p.cover}
              alt={`${p.name}, live show by Féerie in Miami`}
              width={900}
              draggable="false"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.2,0.8,0.2,1)] group-hover:scale-105 card-zoom"
              loading="lazy"
            />
            <div
              class="absolute inset-0"
              style="background:linear-gradient(0deg,#0B0C11 0%,#0B0C11 9%,rgba(11,12,17,.85) 30%,rgba(11,12,17,.3) 54%,rgba(11,12,17,0) 74%),linear-gradient(90deg,rgba(11,12,17,.55) 0%,rgba(11,12,17,0) 16%),linear-gradient(270deg,rgba(11,12,17,.55) 0%,rgba(11,12,17,0) 16%),linear-gradient(180deg,rgba(11,12,17,.35) 0%,rgba(11,12,17,0) 18%)"
              aria-hidden="true"
            />
            {p.featured && (
              <span class="absolute top-5 left-5 rounded-full bg-rose px-3.5 py-2 text-[0.6rem] font-semibold tracking-[0.18em] text-[#120507] uppercase">
                Guest Favorite
              </span>
            )}
            <div class="absolute inset-x-0 bottom-0 flex flex-col gap-2.5 p-6 lg:p-7">
              <h3 class="text-[clamp(1.4rem,2vw,1.75rem)] leading-none text-bone">{p.name}</h3>
              <p class="line-clamp-3 max-w-[46ch] text-[0.85rem] leading-relaxed text-bone/85 [text-shadow:0_1px_12px_rgba(11,12,17,0.9)]">
                {p.description}
              </p>
              <span class="mt-1 inline-flex items-center gap-3 text-[0.72rem] font-medium tracking-[0.18em] text-rose-soft uppercase">
                Discover the show
                <span class="inline-flex size-8 items-center justify-center rounded-full border border-rose text-rose transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:rotate-45 group-hover:bg-rose group-hover:text-[#120507] card-orb">
                  &rarr;
                </span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <div class="mt-9 px-5 sm:px-8 lg:px-12">
    <div class="h-0.5 w-full overflow-hidden rounded-full bg-bone/10">
      <div class="pf-progress h-full w-full origin-left scale-x-0 bg-rose"></div>
    </div>
  </div>
</section>

<script>
  import EmblaCarousel from 'embla-carousel';

  const viewport = document.querySelector<HTMLElement>('.pf-viewport');
  if (viewport) {
    const embla = EmblaCarousel(viewport, {
      align: 'start',
      containScroll: 'trimSnaps',
      dragFree: true,
      skipSnaps: true,
    });

    const prev = document.querySelector<HTMLButtonElement>('.pf-prev');
    const next = document.querySelector<HTMLButtonElement>('.pf-next');
    const progress = document.querySelector<HTMLElement>('.pf-progress');

    prev?.addEventListener('click', () => embla.scrollPrev());
    next?.addEventListener('click', () => embla.scrollNext());

    function update() {
      if (prev) prev.disabled = !embla.canScrollPrev();
      if (next) next.disabled = !embla.canScrollNext();
      if (progress) {
        const value = Math.max(0, Math.min(1, embla.scrollProgress()));
        progress.style.transform = `scaleX(${value})`;
      }
    }

    embla.on('init', update);
    embla.on('scroll', update);
    embla.on('select', update);
    embla.on('reInit', update);
  }
</script>
