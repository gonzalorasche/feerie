---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SiteChrome from '../../components/SiteChrome.astro';
import Footer from '../../components/Footer.astro';
import { performances, imagesFor } from '../../data/performances';

export function getStaticPaths() {
  return performances.map((p) => ({ params: { slug: p.slug }, props: { performance: p } }));
}

const { performance } = Astro.props;
const BASE = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const images = imagesFor(performance.slug);
const [cover, ...gallery] = images;

// Versiones grandes para el visor de desktop/tablet
const fullImages = await Promise.all(
  gallery.map((img) => getImage({ src: img, width: 1600, format: 'webp' }))
);
---

<Base
  title={`${performance.name} | Féerie, Luxury Entertainment in Miami`}
  description={performance.description}
>
  <SiteChrome />
  <main id="page-content">
    <!-- hero del show -->
    <section class="relative flex min-h-[72svh] items-end overflow-hidden bg-ink">
      <Image
        src={cover}
        alt={`${performance.name}, live show by Féerie in Miami`}
        width={1600}
        class="absolute inset-0 h-full w-full object-cover object-[center_30%]"
        loading="eager"
      />
      <div
        class="absolute inset-0"
        style="background:linear-gradient(0deg,#0B0C11 0%,#0B0C11 7%,rgba(11,12,17,.9) 24%,rgba(11,12,17,.35) 54%,rgba(11,12,17,.3) 100%)"
        aria-hidden="true"
      >
      </div>
      <div class="grain absolute inset-0" aria-hidden="true"></div>

      <div class="relative z-10 flex w-full flex-col items-start gap-5 px-5 pt-40 pb-14 sm:px-8 lg:px-12">
        <a
          href={`${BASE}#performances`}
          data-touch
          class="inline-flex w-fit items-center gap-2.5 text-[0.7rem] tracking-[0.2em] uppercase transition-colors hover:text-rose-soft max-lg:rounded-full max-lg:border max-lg:border-bone/20 max-lg:bg-bone/15 max-lg:px-4 max-lg:py-2.5 max-lg:text-bone max-lg:backdrop-blur-md lg:text-dim"
        >
          <span aria-hidden="true">&larr;</span> All performances
        </a>
        <div class="flex flex-wrap items-center gap-4">
          <h1 class="text-[clamp(2.4rem,6.4vw,4.6rem)] leading-[0.98] text-bone">
            {performance.name}
          </h1>
          {
            performance.featured && (
              <span class="rounded-full bg-rose px-3.5 py-2 text-[0.6rem] font-semibold tracking-[0.18em] text-[#120507] uppercase">
                Guest Favorite
              </span>
            )
          }
        </div>
        <p class="max-w-[58ch] text-base leading-relaxed text-bone/85 lg:text-dim">
          {performance.description}
        </p>
      </div>
    </section>

    <!-- galería: apilada en mobile, grilla con visor en desktop/tablet -->
    <section class="bg-ink px-5 py-16 sm:px-8 lg:px-12 lg:py-24">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
        {
          gallery.map((img, i) => (
            <button
              type="button"
              data-touch
              data-index={i}
              data-full={fullImages[i].src}
              aria-label={`View photo of ${performance.name} full size`}
              class="pg-item group overflow-hidden rounded-3xl border border-bone/10 bg-card lg:cursor-none"
            >
              <Image
                src={img}
                alt={`${performance.name} by Féerie, gallery image`}
                width={900}
                draggable="false"
                class="h-auto w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.2,0.8,0.2,1)] group-hover:scale-105 card-zoom sm:aspect-[3/4] sm:h-full"
                loading="lazy"
              />
            </button>
          ))
        }
      </div>
    </section>

    <!-- orbe que sigue al cursor sobre la galería (solo desktop) -->
    <div
      id="cursor-view"
      class="pointer-events-none fixed top-0 left-0 z-[60] hidden size-[4.5rem] items-center justify-center rounded-full bg-rose text-[0.58rem] font-semibold tracking-[0.2em] text-[#120507] uppercase lg:flex"
      aria-hidden="true"
    >
      View
    </div>

    <!-- visor fullscreen (solo desktop y tablet) -->
    <div
      id="lightbox"
      role="dialog"
      aria-modal="true"
      aria-label={`${performance.name} photo viewer`}
      class="fixed inset-0 z-[70] hidden items-center justify-center bg-ink/95 opacity-0 backdrop-blur-md"
    >
      <img
        class="lb-img max-h-[86svh] max-w-[88vw] rounded-2xl object-contain shadow-[0_30px_80px_rgba(0,0,0,0.6)]"
        src=""
        alt={`${performance.name} by Féerie, full size`}
        draggable="false"
      />
      <button
        type="button"
        class="lb-close absolute top-6 right-6 flex size-12 cursor-pointer items-center justify-center rounded-full border border-line-strong text-bone transition-all duration-300 hover:border-rose hover:bg-rose hover:text-[#120507]"
        aria-label="Close viewer"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
      <button
        type="button"
        class="lb-prev absolute left-6 flex size-12 cursor-pointer items-center justify-center rounded-full border border-line-strong text-bone transition-all duration-300 hover:border-rose hover:bg-rose hover:text-[#120507]"
        aria-label="Previous photo"
      >
        &larr;
      </button>
      <button
        type="button"
        class="lb-next absolute right-6 flex size-12 cursor-pointer items-center justify-center rounded-full border border-line-strong text-bone transition-all duration-300 hover:border-rose hover:bg-rose hover:text-[#120507]"
        aria-label="Next photo"
      >
        &rarr;
      </button>
    </div>

    <!-- CTA -->
    <section class="relative overflow-hidden bg-ink px-5 py-20 sm:px-8 lg:py-28">
      <div
        class="absolute inset-0"
        style="background:radial-gradient(50% 65% at 50% 0%,rgba(232,72,110,.08),transparent 70%)"
        aria-hidden="true"
      >
      </div>
      <div class="relative mx-auto flex max-w-[52rem] flex-col items-center gap-6 text-center">
        <p class="eyebrow">Book this show</p>
        <h2 class="max-w-[22ch] text-[clamp(1.9rem,4.6vw,3.4rem)] leading-[1.05] text-bone">
          Bring <em class="not-italic text-rose-soft">{performance.name}</em> to your next event
        </h2>
        <div class="mt-2">
          <a href={`${BASE}#performances`} class="btn btn-fill">Explore More Shows</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  import { gsap } from 'gsap';

  const lb = document.getElementById('lightbox')!;
  const imgEl = lb.querySelector<HTMLImageElement>('.lb-img')!;
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.pg-item'));
  const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;
  let idx = 0;
  let isOpen = false;
  let lastFocus: HTMLElement | null = null;

  function show(i: number) {
    idx = (i + items.length) % items.length;
    imgEl.src = items[idx].dataset.full || '';
    gsap.fromTo(imgEl, { opacity: 0, scale: 0.97 }, { opacity: 1, scale: 1, duration: 0.35, ease: 'power2.out' });
  }

  // Orbe "View" que sigue al cursor sobre las fotos
  const orb = document.getElementById('cursor-view');
  const finePointer = window.matchMedia('(min-width: 1024px) and (pointer: fine)').matches;
  if (orb && finePointer) {
    gsap.set(orb, { xPercent: -50, yPercent: -50, scale: 0 });
    const xTo = gsap.quickTo(orb, 'x', { duration: 0.25, ease: 'power3' });
    const yTo = gsap.quickTo(orb, 'y', { duration: 0.25, ease: 'power3' });
    window.addEventListener('mousemove', (e) => {
      xTo(e.clientX);
      yTo(e.clientY);
    });
    items.forEach((item) => {
      item.addEventListener('mouseenter', () =>
        gsap.to(orb, { scale: 1, duration: 0.35, ease: 'back.out(1.8)' })
      );
      item.addEventListener('mouseleave', () => gsap.to(orb, { scale: 0, duration: 0.25 }));
    });
  }

  function open(i: number) {
    if (!isDesktop()) return;
    isOpen = true;
    if (orb) gsap.to(orb, { scale: 0, duration: 0.2 });
    lastFocus = document.activeElement as HTMLElement;
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.documentElement.style.overflow = 'hidden';
    gsap.to(lb, { opacity: 1, duration: 0.3, ease: 'power2.out' });
    show(i);
    lb.querySelector<HTMLButtonElement>('.lb-close')?.focus();
  }

  function close() {
    isOpen = false;
    gsap.to(lb, {
      opacity: 0,
      duration: 0.25,
      ease: 'power2.in',
      onComplete: () => {
        lb.classList.add('hidden');
        lb.classList.remove('flex');
        document.documentElement.style.overflow = '';
        lastFocus?.focus();
      },
    });
  }

  items.forEach((item, i) => item.addEventListener('click', () => open(i)));
  lb.querySelector('.lb-close')?.addEventListener('click', close);
  lb.querySelector('.lb-prev')?.addEventListener('click', () => show(idx - 1));
  lb.querySelector('.lb-next')?.addEventListener('click', () => show(idx + 1));
  lb.addEventListener('click', (e) => {
    if (e.target === lb) close();
  });
  window.addEventListener('keydown', (e) => {
    if (!isOpen) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
</script>
